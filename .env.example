# Postgres — system of record for bronze/silver/gold (LLD §1.1)
POSTGRES_DSN=postgresql://knowledge:knowledge@localhost:5432/knowledge

# Telegram bot token (Phase 5) — leave blank until S-03
TELEGRAM_BOT_TOKEN=

# LLMClient is one concrete, LiteLLM-routed class (tech design §2.4) — set
# LLM_MODEL to either an Anthropic model name or an OpenAI-compatible URL
# pointed at llama-server; only the matching key/URL below needs a value.
LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
LLAMA_SERVER_URL=http://localhost:8080

# EmbeddingClient backend (LLD §2.1) — "fastembed" (default) or "sentence-transformers"
# Model chosen by the F-05 gate (scripts/validate_embedding_model.py) —
# bge-small-en-v1.5 failed to separate same-story/different-story pairs
# on the hand-labeled sample; all-MiniLM-L6-v2 did.
EMBEDDING_BACKEND=fastembed
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
